# Base URL of the aSocial API (asocial-media-server)
VITE_API_URL=http://localhost:5000

# Optional: WebSocket endpoint for real-time chat. Defaults to VITE_API_URL with ws(s):// and /ws
# (except for *.vercel.app APIs, which can't hold sockets). Set it to an empty value for polling only.
# VITE_WS_URL=ws://localhost:5000/ws
# VITE_WS_URL=
